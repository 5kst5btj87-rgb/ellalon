# Copy to .env and change the secrets before first start.
ELLALON_VERSION=0.1.0
ELLALON_HTTP_PORT=80
ELLALON_DATA_ROOT=/var/lib/ellalon

ELLALON_DB_PASSWORD=change-me-db
ELLALON_JWT_SECRET=change-me-to-a-long-random-string
ELLALON_ADMIN_USER=admin
ELLALON_ADMIN_PASSWORD=change-me-admin

# How often (seconds) core reconciles desired vs actual module state
ELLALON_RECONCILE_INTERVAL=10
